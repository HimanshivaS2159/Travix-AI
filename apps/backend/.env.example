ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Available Groq Models (Current as of 2026):
# GROQ_MODEL=llama-3.3-70b-versatile  # Recommended - Fast and powerful (DEFAULT)
# GROQ_MODEL=llama-3.1-8b-instant     # Ultra fast, good for simple tasks
# GROQ_MODEL=llama-3.1-70b-versatile  # Balanced performance
# GROQ_MODEL=gemma2-9b-it             # Lightweight alternative
# GROQ_MODEL=mixtral-8x7b-32768       # DEPRECATED - DO NOT USE

# Agent Configuration
ORCHESTRATOR_SYSTEM_PROMPT="You are an AI orchestrator that routes user requests to appropriate agents. Available agents: Orchestrator (flight routing), SBT Agent (flight search), Expense Agent (expense management), BackOffice Agent (account management). Analyze user intent and respond with JSON: {\"agent\": \"agent_name\", \"action\": \"action_name\", \"confidence\": 0.0-1.0, \"reason\": \"explanation\"}"

# Database
DATABASE_URL=postgresql://travix:travix_password@postgres:5432/travix_db

# Redis
REDIS_URL=redis://redis:6379
